# ---------------------------------------------------------------------------
# nginx server for the production web bundle. THIS IS A TEMPLATE.
#
# docker/web-entrypoint.d/05-nginx-config.sh runs envsubst over this file at
# container start and writes the result to /etc/nginx/conf.d/default.conf,
# which compose mounts as a tmpfs. Same pattern as the site bundle: the image
# stays read-only, and one generated file reaches nginx.
#
# ONLY the variables named in that script's envsubst call are substituted.
# Every other `$name` in this file — $uri, $auction_cache_control — is an nginx
# variable and survives untouched. Adding a new placeholder here therefore
# means adding it to the envsubst list there as well, or it will reach nginx
# as a literal.
#
# The base image is nginx-unprivileged. That image runs as user 101 and it
# listens on port 8080. A port below 1024 needs root, so do not change 8080.
#
# The served directory is a tmpfs. The entry point copies the bundle into it
# and it writes config.js into it. See
# docker/web-entrypoint.d/10-runtime-config.sh.
#
# TWO NGINX RULES THAT SHAPE THIS FILE
# 1. An `add_header` inside a `location` block REPLACES every inherited
#    header. Every `add_header` therefore stays at `server` level, and the
#    cache policy comes from the `map` below instead of from a location.
# 2. nginx has no backslash line continuation. A quoted value that spans
#    lines keeps the literal backslash. The policy below is therefore on one
#    line.
# ---------------------------------------------------------------------------

# Cache policy per request path. This file is included inside the `http`
# block, so a `map` is valid here.
#
#   /config.js   changes on every container start. A cached copy would point
#                the application at an old contract address.
#   /index.html  names the current bundle. A cached copy would load an old
#                bundle after a redeployment.
#   /assets/*    carries a content hash in the file name, so the same name
#                always holds the same bytes.
map $uri $auction_cache_control {
    default              "no-cache";
    "/config.js"         "no-store, no-cache, must-revalidate";
    "/index.html"        "no-store, no-cache, must-revalidate";
    "/"                  "no-store, no-cache, must-revalidate";
    "~^/assets/"         "public, max-age=31536000, immutable";
}

server {
    listen       8080;
    listen       [::]:8080;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # Do not report the nginx version to a visitor.
    server_tokens off;

    charset utf-8;

    # --- Compression -------------------------------------------------------
    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_comp_level   6;
    gzip_types        text/plain text/css text/javascript application/javascript application/json application/wasm image/svg+xml;

    # --- Headers -----------------------------------------------------------
    # `always` sends the header with an error response as well.
    add_header Cache-Control              $auction_cache_control always;
    add_header X-Content-Type-Options     "nosniff" always;
    add_header X-Frame-Options            "DENY" always;
    add_header Referrer-Policy            "no-referrer" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Permissions-Policy         "camera=(), microphone=(), geolocation=(), payment=()" always;

    # A Content Security Policy for a local demonstration.
    # `connect-src` MUST allow the local JSON-RPC endpoint. `script-src`
    # allows 'unsafe-inline' because a wallet extension injects its own
    # script. Make this policy stricter before any public deployment.
    #
    # TWO DIRECTIVES ARE OPERATOR-CONFIGURABLE, because both depend on where
    # the tokens being auctioned keep their metadata, which this image cannot
    # know at build time:
    #
    #   img-src      Token artwork. An ERC-721 may point `tokenURI` at any
    #                host by design, so the default admits https: broadly.
    #                Images are inert — they execute nothing — and
    #                Referrer-Policy: no-referrer above, plus referrerpolicy
    #                on every <img>, stops the fetch disclosing which page
    #                requested it. Narrow this to your own gateway if you
    #                control every collection you list.
    #   connect-src  The metadata JSON fetch, which is a real XHR and a real
    #                exfiltration channel. The default admits ONLY the local
    #                JSON-RPC endpoint and the default IPFS gateway. Widen it
    #                deliberately, and only to the gateway you configured in
    #                IPFS_GATEWAY.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src ${AUCTION_CSP_IMG_SRC}; font-src 'self' data:; connect-src ${AUCTION_CSP_CONNECT_SRC}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;

    # --- Health probe ------------------------------------------------------
    # The container health check calls this route.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # --- Build assets ------------------------------------------------------
    # A missing asset MUST return 404. A missing asset MUST NOT fall back to
    # index.html, because an HTML body served as JavaScript hides the fault.
    location /assets/ {
        access_log off;
        try_files $uri =404;
    }

    # --- Indexer -----------------------------------------------------------
    # The Ponder indexer runs in the `indexer` Compose profile and is NOT
    # published to the host. Proxying it here keeps every browser request
    # same-origin, so `connect-src 'self'` already covers it and the Content
    # Security Policy above needs no new entry.
    #
    # WHY THE UPSTREAM IS A VARIABLE
    # With a literal `proxy_pass http://indexer:42069` nginx resolves the name
    # once, AT STARTUP, and REFUSES TO START if it does not resolve. That would
    # mean the web container could not boot whenever the indexer profile was
    # switched off -- turning an optional service into a required one. Putting
    # the upstream in a variable defers resolution to request time, so a
    # missing indexer is a 502 on /graphql and nothing else breaks.
    #
    # 127.0.0.11 is Docker's embedded DNS server, which every container on a
    # user-defined network gets.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location ~ ^/(graphql|sql|api)(/|$) {
        set $auction_indexer "indexer:42069";
        proxy_pass http://$auction_indexer;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Ponder's live queries are Server-Sent Events. nginx buffers proxied
        # responses by default, which holds each event until the buffer fills
        # and makes a live feed look frozen. Both settings are required.
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Connection "";

        # An SSE stream is long lived. The default 60s read timeout would cut
        # it and the client would reconnect in a loop.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # --- Application -------------------------------------------------------
    # Single page application fallback. An unknown path returns the shell, so
    # that the client router can handle the route.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # --- Errors ------------------------------------------------------------
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        internal;
        root /usr/share/nginx/html;
    }
}
