# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/

# ---------------------------------------------------------------------------
# Environment. NEVER commit a real .env. Commit .env.example instead.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
dist/
build/
out/
*.tsbuildinfo
.vite/

# ---------------------------------------------------------------------------
# Solidity toolchain output
# ---------------------------------------------------------------------------
contracts/artifacts/
contracts/cache/
contracts/types/
contracts/ignition/deployments/
contracts/coverage/
contracts/.solcache/

# Deployment records are per-machine for local chains. The address is
# deterministic, so it belongs in .env.example, not in a committed file.
contracts/deployments/*.json
!contracts/deployments/.gitkeep

# ---------------------------------------------------------------------------
# Test and analysis output
# ---------------------------------------------------------------------------
coverage/
*.lcov
.nyc_output/
lcov.info
gas-snapshot
.gas-snapshot

# Static analysis reports are regenerated by `make audit`. Do not commit them.
docs/audit/
slither-report.*
*.sarif
crytic-export/

# Playwright
test-results/
playwright-report/
playwright/.cache/
blob-report/

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Docker and local scratch
# ---------------------------------------------------------------------------
.docker/
*.local
tmp/
temp/
.cache/
