# ---------------------------------------------------------------------------
# Files that Git MUST NOT track.
#
# The previous version had a contradiction: `*/build/` removed every build
# directory, and `!backend/build/contracts/DecentralizedAuction.json` tried to
# add one file back. Git cannot re-include a file when a parent DIRECTORY is
# excluded, so that rule never worked. The Truffle build directory is gone
# now, so both rules are gone with it.
# ---------------------------------------------------------------------------

# --- Dependencies ----------------------------------------------------------
node_modules/

# --- Environment -----------------------------------------------------------
# .env holds local values. It is created from .env.example by `make setup`.
# .env.example IS tracked, because it documents every variable.
.env
.env.local
.env.*.local
!.env.example

# --- Contracts (Hardhat 3) -------------------------------------------------
contracts/artifacts/
contracts/cache/
contracts/coverage/
contracts/typechain-types/
contracts/.hardhat/

# The local chain is recreated on every start, so its deployment record is
# disposable. A record for a real network WOULD be tracked, which is why the
# rule names the local chain id and not the whole directory.
contracts/deployments/31337.json

# --- Web (Vite) ------------------------------------------------------------
web/dist/
web/.vite/
web/node_modules/.vite/
web/coverage/
web/stats.html

# --- Runtime configuration --------------------------------------------------
# The nginx entry point writes /usr/share/nginx/html/config.js INSIDE the
# container. Nothing writes a config.js into the working tree, so there is no
# blanket rule here.
#
# `web/public/config.js` IS tracked. It is the development fallback that the
# Vite server serves, and the production entry point overwrites it in the
# container. A blanket `config.js` rule would wrongly exclude it.

# --- Build output ----------------------------------------------------------
dist/
build/
coverage/
.nyc_output/
*.tsbuildinfo

# --- Docker helper ---------------------------------------------------------
# The chain image installs its own packages during the build.
docker/chain/node_modules/

# --- Logs ------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Test output -----------------------------------------------------------
playwright-report/
test-results/
*.lcov

# --- Editor ----------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# --- Operating system ------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Scratch ---------------------------------------------------------------
.cache/
tmp/
temp/
*.tmp
