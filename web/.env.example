# ---------------------------------------------------------------------------
# web/ — LOCAL DEVELOPMENT overrides.
#
#     cp .env.example .env.local
#
# These are LAYER 2 of the config chain. Full order, highest first:
#
#   1. window.__AUCTION_CONFIG__   written into public/config.js by the nginx
#                                  entrypoint at container start. This is how
#                                  ONE built image serves ANY chain.
#   2. import.meta.env.VITE_*      this file. Development only.
#   3. built-in defaults           chainId 31337, http://127.0.0.1:8545, and
#                                  the deterministic deploy addresses.
#
# Layer 2 IS substituted into the bundle at build time, which is why production
# must not rely on it. See src/config/runtime.ts.
#
# Everything here is a local demo value. No real money, no real keys.
# ---------------------------------------------------------------------------

VITE_CHAIN_ID=31337
VITE_CHAIN_NAME=Auction Local

# The URL the BROWSER uses. localhost even when the app is in Docker, because
# the wallet runs on your machine, not inside the container network.
VITE_RPC_URL=http://127.0.0.1:8545

# Deploying from account 0 of the standard test mnemonic at nonce 0/1 always
# produces these addresses, so a fresh local chain matches without editing.
VITE_AUCTION_HOUSE_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
VITE_DEMO_NFT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# Optional. A local chain has no explorer; leave this unset and the UI simply
# omits explorer links rather than rendering dead ones.
# VITE_BLOCK_EXPLORER_URL=

# Optional. WITHOUT a project id the app registers injected wallets only
# (MetaMask and friends), which is correct for a local demo. Setting a
# PLACEHOLDER here is worse than leaving it unset: RainbowKit then advertises
# WalletConnect and shows a QR modal that can never connect.
# VITE_WALLETCONNECT_PROJECT_ID=

# Optional. Where `ipfs://` token metadata and artwork is fetched from. The
# default is a public gateway, which means that gateway's operator learns which
# lots you look at. Point this at your own node to avoid that. It must end in a
# slash; the app adds one if you forget.
# VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/
