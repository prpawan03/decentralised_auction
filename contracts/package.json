{
  "name": "@decentralised-auction/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AuctionHouse \u2014 a reentrancy-safe, pull-payment NFT auction house for a local demo dapp.",
  "license": "MIT",
  "scripts": {
    "build": "hardhat build",
    "clean": "hardhat clean",
    "test": "hardhat test",
    "test:solidity": "hardhat test solidity",
    "test:integration": "hardhat test nodejs",
    "test:coverage": "hardhat test --coverage",
    "test:gas": "hardhat test --gas-stats",
    "node": "hardhat node",
    "deploy": "hardhat run scripts/deploy.ts --network localhost",
    "seed": "hardhat run scripts/seed.ts --network localhost",
    "export-abi": "hardhat run scripts/export-abi.ts",
    "lint": "solhint \"src/**/*.sol\" \"test/**/*.sol\"",
    "typecheck": "hardhat build && tsc --noEmit"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@types/node": "^24.5.2",
    "forge-std": "github:foundry-rs/forge-std#v1.9.7",
    "hardhat": "3.14.0",
    "solhint": "^6.0.0",
    "typescript": "^5.9.2",
    "viem": "^2.47.6"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
