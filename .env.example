# ---------------------------------------------------------------------------
# Copy this file to `.env` before you start the stack:
#
#     cp .env.example .env
#
# Every value here is a LOCAL DEVELOPMENT value. The chain runs on your own
# machine and the accounts hold no real money. Do NOT put a real private key
# in this file, and do NOT use these accounts on a public network.
# ---------------------------------------------------------------------------

# --- Chain ---------------------------------------------------------------
# Chain ID and network ID are the same value. This prevents the mismatch that
# forced the old code to guess between two different identifiers.
CHAIN_ID=31337
CHAIN_NAME=Auction Local
RPC_PORT=8545

# Seconds between blocks. Use 0 for instant mining. Use 2 to see pending
# states during a demo, which looks more like a real network.
BLOCK_TIME=2

# --- Accounts ------------------------------------------------------------
# The standard public test mnemonic. Every Ethereum developer tool uses it.
# It is public on purpose: the accounts are worthless and shared by everyone.
# Import it into MetaMask to get 10 funded demo accounts.
MNEMONIC=test test test test test test test test test test test junk

# Account 0 of the mnemonic above. Deploys the contracts. Public and worthless.
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- Contract ------------------------------------------------------------
# Deploying from account 0 at nonce 0 always gives the same address, so this
# value is stable for everyone. `make up` verifies it and fails if it differs.
AUCTION_HOUSE_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
DEMO_NFT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# --- Web app -------------------------------------------------------------
WEB_PORT=5173
# The URL the BROWSER uses. It is localhost even in Docker, because MetaMask
# runs on your machine and not inside the container network.
PUBLIC_RPC_URL=http://127.0.0.1:8545

# Seed demo auctions on startup so the app is never empty during a demo.
SEED_DEMO_DATA=true

# Where `ipfs://` NFT metadata and artwork is fetched from. Leave empty to use
# the built-in public gateway. That gateway's operator can see which lots a
# visitor's browser loads, so a deployment that cares about that should point
# this at its own node. Must end in a slash.
IPFS_GATEWAY=

# --- Content Security Policy ------------------------------------------------
# Both are optional; empty keeps the defaults in
# docker/web-entrypoint.d/05-nginx-config.sh.
#
# `img-src` defaults to allowing https: because an ERC-721 may host its artwork
# anywhere by design, and an image executes nothing.
# `connect-src` defaults to the local JSON-RPC endpoint plus the default IPFS
# and Arweave gateways ONLY, because the metadata fetch is a real XHR. If you
# change IPFS_GATEWAY above you MUST add that origin here, or the browser
# blocks the fetch and every listing falls back to a placeholder tile.
CSP_IMG_SRC=
CSP_CONNECT_SRC=

# ---------------------------------------------------------------------------
# Optional profiles
#
# The base stack is chain + deployer + web. Everything below is opt-in through
# a Compose profile, so `make up` stays small and fast:
#
#   make indexer     chain + deployer + web + Postgres + the Ponder indexer
#   make monitoring  chain + deployer + web + Prometheus + Grafana + exporter
#   make full        all of the above
# ---------------------------------------------------------------------------

# Seed the curated catalogue with its original remote photographs instead of
# the self-contained cover plates. Worth running once beside the default: it
# shows what a listing depends on when its artwork lives on someone else's
# host. Requires CSP_IMG_SRC to allow https:, which is the shipped default.
SEED_HOSTED_IMAGES=false

# Grafana and Prometheus, published on the loopback interface only.
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# The indexer is deliberately NOT published. nginx proxies /graphql, /sql and
# /api to it so the browser stays same-origin and the Content Security Policy
# needs no extra entry. Reach it at http://127.0.0.1:${WEB_PORT}/graphql.
#
# Postgres for the indexer. These credentials never leave the Compose network.
INDEXER_DB_PASSWORD=ponder
