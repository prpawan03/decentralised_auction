{
  "name": "@auction-house/mcp",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server that lets an AI agent browse and bid on the local NFT auction house",
  "license": "MIT",
  "type": "module",
  "bin": {
    "auction-house-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "node --experimental-strip-types src/index.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "viem": "^2.37.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
